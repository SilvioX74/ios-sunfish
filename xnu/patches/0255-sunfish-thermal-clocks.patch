Date: Sat, 31 Oct 2026 17:05:51 -0400
Subject: [PATCH] sunfish: thermal and real clock log (0255)

---
 bsd/conf/files          |   1 +
 bsd/dev/sweet_cpufreq.c | 101 +++++++++++++++++++++-
 bsd/dev/sweet_thermal.c | 180 ++++++++++++++++++++++++++++++++++++++++
 osfmk/kern/sched_prim.c |  19 +++++
 4 files changed, 299 insertions(+), 2 deletions(-)
 create mode 100644 bsd/dev/sweet_thermal.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 1963941..df0a5ba 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -111,6 +111,7 @@ bsd/dev/sweet_touch.c			standard
 bsd/dev/sweet_motion.c			standard
 bsd/dev/sweet_fts.c			standard
 bsd/dev/sweet_cpufreq.c			standard
+bsd/dev/sweet_thermal.c			standard
 bsd/dev/sweet_dark.c			standard
 bsd/dev/sweet_cpusample.c			standard
 bsd/dev/sweet_poke.c			standard
diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 66a5700..9d318cc 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -7,6 +7,10 @@
  *
  * Boot-arg flamecpufreq: 0 leave as is, 1 (default) highest all-core
  * frequency, N > 1 the highest entry at or below N MHz.
+ *
+ * 0255 (ios-redfin 0961, MIT; read only): sweet_cpufreq_log(), called from the 5 s thread in
+ * bsd/dev/sweet_thermal.c, prints busy %, the desired index, the raw OSM cycle counter delta, the raw
+ * LMh register and four L3 registers. sweettherm=0: L3 and LMh not mapped, no thread.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -15,24 +19,43 @@
 #include <sys/errno.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <mach/mach_time.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern uint64_t sweet_cpu_idle_abs(int cpu);    /* osfmk/kern/sched_prim.c (0255) */
+extern void sweet_thermal_start(void);          /* bsd/dev/sweet_thermal.c (0255) */
 void sweet_cpufreq_init(void);
+void sweet_cpufreq_log(void);
 
 #define OSM_FREQ_REG    0x110u          /* + 32 * index */
 #define OSM_ROW         32u
 #define OSM_ROWS        40u
 #define OSM_DESIRED     0x920u          /* + 4 * core in cluster; core 0 drives the policy */
 #define OSM_XO_KHZ      19200u
+#define OSM_CYCLES      0x9c0u          /* 0255: unverified on sunfish, printed raw */
+#define OSM_L3_PA       0x18321000u     /* 0255: the L3 domain, read only */
+#define OSM_L3_VOTES    0x920u          /* 0255: + 4 * voter (a guess, heat-2026-10-31.md), printed raw */
+#define LMH_REG         0x704u          /* 0255: unverified on sunfish: 0 no cap, else (raw & 0x3ff) * 19.2 MHz */
 
 static const struct {
 	const char *name;
 	uint32_t pa;
+	const char *tag;
+	uint32_t lmh_pa;
 } osm_clusters[] = {
-	{"pwrcl (A55 x6)", 0x18323000u},
-	{"perfcl (A76 x2)", 0x18325800u},
+	{"pwrcl (A55 x6)", 0x18323000u, "a55", 0x18358800u + LMH_REG},
+	{"perfcl (A76 x2)", 0x18325800u, "a76", 0x18350800u + LMH_REG},
 };
 
+/* 0255: what sweet_cpufreq_log() needs; each block is mapped once, in sweet_cpufreq_init */
+static struct {
+	vm_offset_t base, lmh;
+	unsigned n;
+	uint32_t khz[OSM_ROWS];
+	uint32_t cyc_prev;
+} osm_state[2];
+static vm_offset_t osm_l3;
+
 static uint32_t
 osm_rd(vm_offset_t base, uint32_t off)
 {
@@ -52,6 +75,7 @@ sweet_cpufreq_init(void)
 			printf("SWEET CPUFREQ: %s: map failed\n", osm_clusters[c].name);
 			continue;
 		}
+		osm_state[c].base = base;
 		uint32_t cur = osm_rd(base, OSM_DESIRED);
 		unsigned best = cur, best_khz = 0, prev_khz = 0, n = 0;
 		char line[256];
@@ -65,6 +89,8 @@ sweet_cpufreq_init(void)
 			}
 			prev_khz = khz;
 			n = i + 1;
+			osm_state[c].khz[i] = khz;
+			osm_state[c].n = n;
 			if (len < sizeof(line) - 16) {
 				len += snprintf(line + len, sizeof(line) - len, " %u%s", khz / 1000,
 				    cores == 1 ? "*" : "");
@@ -89,6 +115,77 @@ sweet_cpufreq_init(void)
 		printf("SWEET CPUFREQ: %s index %u -> %u (%u MHz), reads back %u\n",
 		    osm_clusters[c].name, cur, best, best_khz / 1000, osm_rd(base, OSM_DESIRED));
 	}
+	/* 0255: only maps here; the first reads of these blocks are in the thread (sweettherm=0: none of it) */
+	unsigned therm = 1;
+	(void)PE_parse_boot_argn("sweettherm", &therm, sizeof(therm));
+	if (therm) {
+		osm_l3 = ml_io_map(OSM_L3_PA, 0x1000);
+		for (unsigned c = 0; c < sizeof(osm_clusters) / sizeof(osm_clusters[0]); ++c) {
+			osm_state[c].lmh = ml_io_map(osm_clusters[c].lmh_pa, 4);
+		}
+	}
+	sweet_thermal_start();
+}
+
+/*
+ * 0255: the first call only takes the baseline and prints nothing, so every line covers a full 5 s.
+ * Only the 5 s thread calls this; no locks.
+ */
+void
+sweet_cpufreq_log(void)
+{
+	static uint64_t idle_prev[8], t_prev;
+	const unsigned ndom = sizeof(osm_clusters) / sizeof(osm_clusters[0]);
+	uint64_t now = mach_absolute_time(), dt = now - t_prev;
+	bool first = t_prev == 0;
+	unsigned busy[8];
+	for (unsigned c = 0; c < 8; ++c) {
+		uint64_t idle = sweet_cpu_idle_abs((int)c), di = idle - idle_prev[c];
+		/* idle 0: no such CPU or not started yet */
+		busy[c] = (!first && idle && dt && di <= dt) ? (unsigned)(100 - (di * 100) / dt) : 0;
+		idle_prev[c] = idle;
+	}
+	t_prev = now;
+	if (first) {
+		for (unsigned d = 0; d < ndom; ++d) {
+			if (osm_state[d].base) {
+				osm_state[d].cyc_prev = osm_rd(osm_state[d].base, OSM_CYCLES);
+			}
+		}
+		return;
+	}
+	static bool announced;
+	if (!announced) {
+		announced = true;
+		printf("SWEET THERM: first L3 and LMh read\n");
+	}
+	char line[256];
+	unsigned len = 0;
+	len += snprintf(line + len, sizeof(line) - len, "SWEET THERM: busy %u %u %u %u %u %u | %u %u %%;",
+	    busy[0], busy[1], busy[2], busy[3], busy[4], busy[5], busy[6], busy[7]);
+	for (unsigned d = 0; d < ndom; ++d) {
+		if (!osm_state[d].base) {
+			len += snprintf(line + len, sizeof(line) - len, " %s --;", osm_clusters[d].tag);
+			continue;
+		}
+		uint32_t idx = osm_rd(osm_state[d].base, OSM_DESIRED), cyc = osm_rd(osm_state[d].base, OSM_CYCLES);
+		uint32_t delta = cyc - osm_state[d].cyc_prev;
+		osm_state[d].cyc_prev = cyc;
+		len += snprintf(line + len, sizeof(line) - len, " %s %u=%u cyc %u lmh ", osm_clusters[d].tag, idx,
+		    idx < osm_state[d].n ? osm_state[d].khz[idx] / 1000 : 0, delta);
+		if (osm_state[d].lmh) {
+			len += snprintf(line + len, sizeof(line) - len, "%x;", osm_rd(osm_state[d].lmh, 0));
+		} else {
+			len += snprintf(line + len, sizeof(line) - len, "--;");
+		}
+	}
+	if (osm_l3) {
+		len += snprintf(line + len, sizeof(line) - len, " l3 %x %x %x %x", osm_rd(osm_l3, OSM_L3_VOTES),
+		    osm_rd(osm_l3, OSM_L3_VOTES + 4), osm_rd(osm_l3, OSM_L3_VOTES + 8), osm_rd(osm_l3, OSM_L3_VOTES + 12));
+	} else {
+		len += snprintf(line + len, sizeof(line) - len, " l3 --");
+	}
+	printf("%s\n", line);
 }
 
 /*
diff --git a/bsd/dev/sweet_thermal.c b/bsd/dev/sweet_thermal.c
new file mode 100644
index 0000000..79de6f5
--- /dev/null
+++ b/bsd/dev/sweet_thermal.c
@@ -0,0 +1,180 @@
+/*
+ * 0255 (ios-redfin 0960, MIT): sunfish (SM7150) temperatures from the two TSENS controllers, read only.
+ * Addresses and the sensor map from the live DT (thermal-zones, cooling maps):
+ *
+ *   tsens0 TM 0x0c263000: 0 aoss, 1-6 A55, 7-8 cpuss, 9-10 CPU6, 11-12 CPU7, 13-14 gpu
+ *   tsens1 TM 0x0c265000: 0 aoss, 1 wlan, 3 ddr, 5 camera
+ *
+ * Status of sensor n: TM + 0xa0 + 4n, bits 11:0 signed deci-C, bit 21 valid; TM + 0xe4 bit 3 ready.
+ * Nothing is written. A reading that looks invalid is "--", with no retry until the next round.
+ * The DT node has no clocks and these blocks have not been read here before: a reset on the first
+ * boot may come from these reads.
+ *
+ * Every 5 s: two "SWEET THERM:" lines, the second from sweet_cpufreq_log() (bsd/dev/sweet_cpufreq.c);
+ * sysctl kern.sweet_temp_* in deci-C (-9999 = no reading). Boot-arg sweettherm=0: off.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void sweet_cpufreq_log(void);
+void sweet_thermal_start(void);
+
+#define TS0_TM_PA       0x0c263000u
+#define TS1_TM_PA       0x0c265000u
+#define TS_SN_STATUS    0xa0u
+#define TS_TRDY         0xe4u
+#define TS_TRDY_BIT     (1u << 3)
+#define TS_VALID        (1u << 21)
+#define TS_NONE         (-9999)
+#define TS_PERIOD_MS    5000u
+
+static vm_offset_t ts_tm[2];
+static int t_a55 = TS_NONE, t_a76 = TS_NONE, t_gpu = TS_NONE, t_ddr = TS_NONE, t_max = TS_NONE;
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_temp_a55, CTLFLAG_RD | CTLFLAG_LOCKED, &t_a55, 0, "SWEET THERM: hottest A55, deci-C");
+SYSCTL_INT(_kern, OID_AUTO, sweet_temp_a76, CTLFLAG_RD | CTLFLAG_LOCKED, &t_a76, 0, "SWEET THERM: hottest A76, deci-C");
+SYSCTL_INT(_kern, OID_AUTO, sweet_temp_gpu, CTLFLAG_RD | CTLFLAG_LOCKED, &t_gpu, 0, "SWEET THERM: GPU, deci-C");
+SYSCTL_INT(_kern, OID_AUTO, sweet_temp_ddr, CTLFLAG_RD | CTLFLAG_LOCKED, &t_ddr, 0, "SWEET THERM: DDR, deci-C");
+SYSCTL_INT(_kern, OID_AUTO, sweet_temp_max, CTLFLAG_RD | CTLFLAG_LOCKED, &t_max, 0, "SWEET THERM: hottest sensor, deci-C");
+
+static uint32_t
+ts_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static bool
+ts_ready(unsigned ctl)
+{
+	return (ts_rd(ts_tm[ctl], TS_TRDY) & TS_TRDY_BIT) != 0;
+}
+
+/* One read of one sensor, deci-C, or TS_NONE */
+static int
+ts_read(unsigned ctl, unsigned n)
+{
+	uint32_t code = ts_rd(ts_tm[ctl], TS_SN_STATUS + 4u * n);
+	if (code == 0xffffffffu || !(code & TS_VALID)) {
+		return TS_NONE;
+	}
+	int v = (int)(code & 0xfffu);
+	if (v & 0x800) {
+		v -= 0x1000;
+	}
+	return (v < -400 || v > 1500) ? TS_NONE : v;
+}
+
+static int
+ts_hot(int a, int b)
+{
+	return a > b ? a : b;
+}
+
+/* "41.3" or "--" */
+static const char *
+ts_fmt(char *buf, size_t len, int v)
+{
+	if (v == TS_NONE) {
+		snprintf(buf, len, "--");
+	} else {
+		snprintf(buf, len, "%s%d.%d", v < 0 ? "-" : "", (v < 0 ? -v : v) / 10, (v < 0 ? -v : v) % 10);
+	}
+	return buf;
+}
+
+static void
+ts_round(void)
+{
+	int s0[15], wlan = TS_NONE, ddr = TS_NONE, cam = TS_NONE, aoss1 = TS_NONE;
+	bool ready = ts_ready(0);
+	for (unsigned i = 0; i < 15; ++i) {
+		s0[i] = ready ? ts_read(0, i) : TS_NONE;
+	}
+	if (ts_ready(1)) {
+		aoss1 = ts_read(1, 0);
+		wlan = ts_read(1, 1);
+		ddr = ts_read(1, 3);
+		cam = ts_read(1, 5);
+	}
+	int a55 = TS_NONE;
+	for (unsigned i = 1; i <= 6; ++i) {
+		a55 = ts_hot(a55, s0[i]);
+	}
+	int cpuss = ts_hot(s0[7], s0[8]), cpu6 = ts_hot(s0[9], s0[10]), cpu7 = ts_hot(s0[11], s0[12]);
+	int gpu = ts_hot(s0[13], s0[14]), aoss = ts_hot(s0[0], aoss1);
+	int m = ts_hot(ts_hot(a55, cpuss), ts_hot(cpu6, cpu7));
+	m = ts_hot(ts_hot(m, gpu), ts_hot(aoss, ts_hot(wlan, ts_hot(ddr, cam))));
+	t_a55 = a55;
+	t_a76 = ts_hot(cpu6, cpu7);
+	t_gpu = gpu;
+	t_ddr = ddr;
+	t_max = m;
+
+	char a[9][12];
+	printf("SWEET THERM: a55 %s cpu6 %s cpu7 %s cpuss %s gpu %s ddr %s cam %s wlan %s aoss %s C\n",
+	    ts_fmt(a[0], 12, a55), ts_fmt(a[1], 12, cpu6), ts_fmt(a[2], 12, cpu7), ts_fmt(a[3], 12, cpuss),
+	    ts_fmt(a[4], 12, gpu), ts_fmt(a[5], 12, ddr), ts_fmt(a[6], 12, cam), ts_fmt(a[7], 12, wlan),
+	    ts_fmt(a[8], 12, aoss));
+}
+
+/* Starts only after the maps exist; holds no lock across the reads. */
+static void
+ts_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static int ts_chan;
+	bool probed = false;
+	sweet_cpufreq_log();    /* baseline for busy % and cycles, prints nothing */
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(TS_PERIOD_MS, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&ts_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (!probed) {
+			/* once: names the block if a read resets the phone, and shows the raw values behind "--" */
+			probed = true;
+			printf("SWEET THERM: first TSENS read\n");
+			printf("SWEET THERM: tsens0 trdy %x s1 %x, tsens1 trdy %x s3 %x\n",
+			    ts_rd(ts_tm[0], TS_TRDY), ts_rd(ts_tm[0], TS_SN_STATUS + 4), ts_rd(ts_tm[1], TS_TRDY),
+			    ts_rd(ts_tm[1], TS_SN_STATUS + 12));
+		}
+		ts_round();
+		sweet_cpufreq_log();
+	}
+}
+
+void
+sweet_thermal_start(void)
+{
+	unsigned on = 1;
+	(void)PE_parse_boot_argn("sweettherm", &on, sizeof(on));
+	if (!on) {
+		printf("SWEET THERM: off (sweettherm=0)\n");
+		return;
+	}
+	ts_tm[0] = ml_io_map(TS0_TM_PA, 0x1000);
+	ts_tm[1] = ml_io_map(TS1_TM_PA, 0x1000);
+	if (!ts_tm[0] || !ts_tm[1]) {
+		printf("SWEET THERM: map failed\n");
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(ts_thread, NULL, &t) != KERN_SUCCESS) {
+		printf("SWEET THERM: thread failed\n");
+		return;
+	}
+	thread_deallocate(t);
+	printf("SWEET THERM: on, every 5 s (sweettherm=0 off)\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index 16840ec..7166253 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -5009,6 +5009,25 @@ choose_next_pset(
 	return nset;
 }
 
+#if defined(__arm64__)
+/*
+ * sunfish 0255 (ios-redfin 0961, MIT): idle time of one CPU (mach absolute time) for the busy % in
+ * bsd/dev/sweet_cpufreq.c; 0 if the CPU does not exist.
+ */
+uint64_t sweet_cpu_idle_abs(int cpu);
+uint64_t
+sweet_cpu_idle_abs(int cpu)
+{
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS || processor_array[cpu] == PROCESSOR_NULL) {
+		return 0;
+	}
+	struct recount_usage usage = { 0 };
+	uint64_t idle = 0;
+	recount_processor_usage(&processor_array[cpu]->pr_recount, &usage, &idle);
+	return idle;
+}
+#endif
+
 /*
  *	choose_processor:
  *
-- 
2.56.0

