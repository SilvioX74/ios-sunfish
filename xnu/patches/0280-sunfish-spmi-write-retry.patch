From 1500e927173996a214e8dd423eb5da1bf8334b8c Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Tue, 3 Nov 2026 18:05:55 -0500
Subject: [PATCH] sunfish: SPMI writes with FAILURE/DROPPED status retry the
 same register/value up to 3 tries (150 us apart), and the keys poll takes
 sp_lock around its reads; sweetspmiretry=0 turns both off (0280, B59)

---
 bsd/dev/sweet_keys.c |  4 +++
 bsd/dev/sweet_spmi.c | 73 +++++++++++++++++++++++++++++++++++---------
 bsd/dev/sweet_spmi.h |  4 +++
 3 files changed, 66 insertions(+), 15 deletions(-)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index fb88ea8..7850dbb 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -20,6 +20,8 @@ void sweet_keys_init(void);
 extern int sweet_display_dark;          /* 0242: bsd/dev/sweet_dark.c */
 extern void sweet_dark_sleep(uint32_t ms);
 extern const uint32_t sweet_dark_keys_ms;
+extern bool sweet_spmi_bus_lock(void);      /* 0280: bsd/dev/sweet_spmi.c */
+extern void sweet_spmi_bus_unlock(bool locked);
 
 #define KEYS_CORE_PA     0x0c440000u
 #define KEYS_OBS_PA      0x0e600000u
@@ -105,8 +107,10 @@ keys_thread(void *arg, wait_result_t result)
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
+		bool held = sweet_spmi_bus_lock(); /* 0280: not during PMIC writes */
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		sweet_spmi_bus_unlock(held);
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 8108ca6..09fdad8 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -12,6 +12,8 @@
  * 0218: and PM6150L GPIO 1/4/5/6 (SID 4, 0xc000/0xc300/0xc400/0xc500), the SLG51000
  * camera PMIC enable/cs lines (sweetcampmic=1 read, =2 drive), same registers.
  * 0247: and PM6150L GPIO 12 (SID 4, 0xcb00), the lens motor rail cam_vaf (kern.sweet_camvaf).
+ * 0280: a FAILURE/DROPPED write repeats the same value (3 tries), and the keys poll shares
+ * sp_lock (sweetspmiretry=0 turns both off).
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -37,6 +39,9 @@ static vm_offset_t sp_core, sp_obs, sp_cfg;
 static IOLock *sp_lock;
 static unsigned sp_count;
 static bool sp_attempted, sp_ready;
+/* 0280: sweetspmiretry=0 turns off the write retry and the keys poll sharing sp_lock */
+static int sp_retry = 1;
+static bool sp_shared;
 /* A timed-out command may complete late: never reuse that lane this boot. */
 static bool sp_poisoned[512];
 
@@ -92,11 +97,32 @@ sweet_spmi_init(void)
 		return -1;
 	}
 	sp_ready = true;
-	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
-	    arb_version, sp_count);
+	(void)PE_parse_boot_argn("sweetspmiretry", &sp_retry, sizeof(sp_retry)); /* 0280 */
+	__atomic_store_n(&sp_shared, sp_retry != 0, __ATOMIC_RELEASE);
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only, retry %d\n",
+	    arb_version, sp_count, sp_retry);
 	return 0;
 }
 
+/* 0280: the keys poll (sweet_keys.c, own mapping) holds sp_lock around its reads once it exists. */
+bool
+sweet_spmi_bus_lock(void)
+{
+	if (!__atomic_load_n(&sp_shared, __ATOMIC_ACQUIRE)) {
+		return false;
+	}
+	IOLockLock(sp_lock);
+	return true;
+}
+
+void
+sweet_spmi_bus_unlock(bool locked)
+{
+	if (locked) {
+		IOLockUnlock(sp_lock);
+	}
+}
+
 int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
@@ -202,23 +228,40 @@ sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
 		sp_chnl = m;
 		sp_chnl_apid = apid;
 	}
-	__asm__ volatile("dmb oshst" ::: "memory");
-	*(volatile uint32_t *)(sp_chnl + 0x10u) = val; /* WDATA0 */
-	__asm__ volatile("dmb oshst" ::: "memory");
-	*(volatile uint32_t *)(sp_chnl + 0x00u) = (0u << 27) | (reg << 4); /* EXT_WRITEL, BC=0 */
-	__asm__ volatile("dsb osh" ::: "memory");
-	for (unsigned i = 0; i < 1000; ++i) {
-		uint32_t status = sp_rd(sp_chnl, 0x08u);
-		if (status & 1u) {
-			IOLockUnlock(sp_lock);
-			if (status & 0x0eu) {
-				printf("SWEET TORCH: write %#x status %#x\n", addr, status);
-				return EIO;
+	/* 0280: FAILURE (bit 1) or DROPPED (bit 3, seen as 0x9 under bus contention) repeats
+	 * the same register/value up to 3 tries; DENIED (bit 2) and timeouts never retry. */
+	for (unsigned attempt = 1;; ++attempt) {
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(sp_chnl + 0x10u) = val; /* WDATA0 */
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(sp_chnl + 0x00u) = (0u << 27) | (reg << 4); /* EXT_WRITEL, BC=0 */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t status = 0;
+		for (unsigned i = 0; i < 1000 && !(status & 1u); ++i) {
+			status = sp_rd(sp_chnl, 0x08u);
+			if (!(status & 1u)) {
+				delay(1);
 			}
+		}
+		if (!(status & 1u)) {
+			break;
+		}
+		if (!(status & 0x0eu)) {
+			IOLockUnlock(sp_lock);
 			printf("SWEET TORCH: sid %u %#x <- %#x\n", sid, addr, val);
 			return 0;
 		}
-		delay(1);
+		if (sp_retry && !(status & 0x04u) && attempt < 3) {
+			printf("SWEET SPMI: write %#x retry %u after status %#x\n", addr, attempt, status);
+			delay(150);
+			continue;
+		}
+		IOLockUnlock(sp_lock);
+		printf("SWEET TORCH: write %#x status %#x\n", addr, status);
+		if (attempt > 1) {
+			printf("SWEET SPMI: write %#x gave up after %u tries\n", addr, attempt);
+		}
+		return EIO;
 	}
 	sp_poisoned[apid] = true;
 	printf("SWEET TORCH: SPMI write timeout %#x APID=%u disabled\n", addr, apid);
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
index 72520d7..2164452 100644
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -2,6 +2,7 @@
 #ifndef SWEET_BATTERY_SPMI_H
 #define SWEET_BATTERY_SPMI_H
 #include <stdint.h>
+#include <stdbool.h>
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -10,6 +11,9 @@ int sweet_spmi_init(void);
 int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
 /* 0190: flash LED control registers only (SID 5, 0xd3xx); 0217: + SID 4 GPIO 8/11; 0 or errno. */
 int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
+/* 0280: sp_lock for the keys poll; false (no lock taken) before init or with sweetspmiretry=0. */
+bool sweet_spmi_bus_lock(void);
+void sweet_spmi_bus_unlock(bool locked);
 void sweet_ampreset_register(void); /* 0217 */
 void sweet_torch_register(void);
 #ifdef __cplusplus
-- 
2.56.0

