 	}
 	thread_deallocate(t);
-	printf("SWEET THERM: on, every 5 s (sweettherm=0 off)\n");
+	printf("SWEET THERM: on, every 5 s (sweettherm=0 off); thermal cap %s (sweetthermcap=0 off)\n", ts_cap_on ? "on" : "off");
