 	vm_offset_t base, lmh;
 	unsigned n;
 	uint32_t khz[OSM_ROWS];
-	uint32_t cyc_prev;
+	bool cap_on;            /* 0256 */
+	unsigned boot_row, cap_row, cap_floor;
