+ * sweettherm=0: L3 and LMh not mapped, no thread.
+ * 0256: "real" on that line is the MHz measured from the OSM cycle counter over about 100 ms (32 bits, wraps within
+ * 5 s). The hardware cut the A76 by about 10 % at cpu6 94-95 C with the row and LMh register unchanged.
+ * sysctl kern.sweet_mhz_{a55,a76}: the same values.
+ *
+ * 0256: sweet_cpufreq_cap(), called only from that thread (policy in sweet_thermal.c), moves the desired
+ * index within floor..boot row, where the boot row is what init left. Voltage stays with OSM/CPR.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
