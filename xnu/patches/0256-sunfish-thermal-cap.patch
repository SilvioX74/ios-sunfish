 ts_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	static int ts_chan;
 	bool probed = false;
+	unsigned since_log = 0; /* 0256: ms; slow samples land on the 5 s log rounds */
 	sweet_cpufreq_log();    /* baseline for busy % and cycles, prints nothing */
 	for (;;) {
 		uint64_t deadline;
-		clock_interval_to_deadline(TS_PERIOD_MS, NSEC_PER_MSEC, &deadline);
+		bool fast = ts_cap_on && (t_cpu >= TS_CAP_FAST || t_cap >= TS_CAP_DOWN);
+		unsigned wait_ms = TS_PERIOD_MS - since_log;
+		if (fast && wait_ms > TS_CAP_FAST_MS) {
+			wait_ms = TS_CAP_FAST_MS;
+		}
+		clock_interval_to_deadline(wait_ms, NSEC_PER_MSEC, &deadline);
 		(void)assert_wait_deadline(&ts_chan, THREAD_UNINT, deadline);
 		thread_block(THREAD_CONTINUE_NULL);
 		if (!probed) {
@@ -149,8 +210,16 @@ ts_thread(void *arg __unused, wait_result_t wr __unused)
 			    ts_rd(ts_tm[0], TS_TRDY), ts_rd(ts_tm[0], TS_SN_STATUS + 4), ts_rd(ts_tm[1], TS_TRDY),
 			    ts_rd(ts_tm[1], TS_SN_STATUS + 12));
 		}
-		ts_round();
-		sweet_cpufreq_log();
+		since_log += wait_ms;
+		bool log = since_log >= TS_PERIOD_MS;
+		ts_round(log);
+		if (ts_cap_on) {
+			ts_cap_policy(wait_ms);
+		}
+		if (log) {
+			sweet_cpufreq_log();
+			since_log = TS_LOG_MS;
+		}
 	}
 }
 
@@ -163,6 +232,7 @@ sweet_thermal_start(void)
 		printf("SWEET THERM: off (sweettherm=0)\n");
 		return;
 	}
+	(void)PE_parse_boot_argn("sweetthermcap", &ts_cap_on, sizeof(ts_cap_on));
 	ts_tm[0] = ml_io_map(TS0_TM_PA, 0x1000);
