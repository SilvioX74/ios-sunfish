From 34b40e670980b7aa8e21f67605d4b169424d2b8a Mon Sep 17 00:00:00 2001
From: Yofuness <compiledchickennuggets@gmail.com>
Date: Sun, 1 Nov 2026 13:49:25 -0500
Subject: [PATCH] sunfish: screen-on CPU governor, sweetgov (0261)

---
 bsd/dev/sweet_cpufreq.c           | 193 +++++++++++++++++++++++++++++-
 bsd/dev/sweet_gpu.c               |   2 +
 iokit/Kernel/arm/hid/SweetHID.cpp |   2 +
 3 files changed, 194 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 970a2a0..f00c7a2 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -27,6 +27,14 @@
  *
  * 0260: with neither sweetrowa55 nor flamecpufreq given, the A55 boot row is 6 (1497 MHz). Off: sweetrowa55=9 (1804 MHz) or
  * any flamecpufreq=N. Log line "rows ... (default)" when only this picked a row.
+ *
+ * 0261 (idea from ios-redfin 0963, MIT): boot-arg sweetgov=1 (default 0: off), a governor thread, tick 20 ms with the
+ * display on, 100 ms dark. Per domain: to the boot row at once on touch, a GPU submit burst (4 submits in 33 ms) or a
+ * display wake, held 300 ms; else busiest core of the domain over the last tick: over 70 % to the boot row, under 30 %
+ * for 100 ms a row down, to the floor. Floors: sweetgovfloor55=R (default 6, 1497 MHz: 1248 MHz raised GPU hangs in
+ * rows2), sweetgovfloor76=R (default 5, 1209 MHz); kept within cap floor..boot row, so with the 0260 boot row the A55
+ * doesn't move unless sweetrowa55 is higher. Effective row = lowest of cap, dark and governor. Busy line: "gov up N dn M"
+ * after "dark N", rows moved summed over both domains; sweetgov=0: no thread, the line as before.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -45,10 +53,14 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern uint64_t sweet_cpu_idle_abs(int cpu);    /* osfmk/kern/sched_prim.c (0255) */
 extern void sweet_thermal_start(void);          /* bsd/dev/sweet_thermal.c (0255) */
 extern int sweet_display_dark;                  /* bsd/dev/sweet_dark.c (0242) */
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);        /* 0261 */
+extern void thread_deallocate(thread_t);        /* 0261 */
 void sweet_cpufreq_init(void);
 void sweet_cpufreq_log(void);
 void sweet_cpufreq_cap(int dir, const char *temp);
 void sweet_cpufreq_dark(int dark);
+void sweet_cpufreq_gov_kick(void);      /* 0261: touch (SweetHID.cpp) */
+void sweet_cpufreq_gov_submit(void);    /* 0261: GPU submits (sweet_gpu.c) */
 
 #define OSM_FREQ_REG    0x110u          /* + 32 * index */
 #define OSM_ROW         32u
@@ -60,6 +72,15 @@ void sweet_cpufreq_dark(int dark);
 #define OSM_L3_PA       0x18321000u     /* 0255: the L3 domain, read only */
 #define OSM_L3_VOTES    0x920u          /* 0255: + 4 * voter (a guess, heat-2026-10-31.md), printed raw */
 #define LMH_REG         0x704u          /* 0255: unverified on sunfish: 0 no cap, else (raw & 0x3ff) * 19.2 MHz */
+/* 0261: top of this file */
+#define OSM_GOV_TICK_MS 20u
+#define OSM_GOV_DARK_MS 100u
+#define OSM_GOV_HOLD_MS 300u
+#define OSM_GOV_DOWN_MS 100u
+#define OSM_GOV_UP_PCT  70u
+#define OSM_GOV_DOWN_PCT 30u
+#define OSM_GOV_BURST_N 4u              /* scrolling is about 160 submits/s (5 per window), a resting UI about 25 */
+#define OSM_GOV_BURST_MS 33u
 
 static const struct {
 	const char *name;
@@ -70,9 +91,12 @@ static const struct {
 	unsigned dark_row;      /* 0257: highest row while the display is dark */
 	const char *row_arg;    /* 0258: boot-arg for the boot row */
 	unsigned row_default;   /* 0260: boot row without a boot-arg; 0: flamecpufreq picks */
+	const char *gov_arg;    /* 0261: boot-arg for the governor's floor */
+	unsigned gov_floor;     /* 0261: its default */
+	unsigned cpu_first, cpu_n;      /* 0261 */
 } osm_clusters[] = {
-	{"pwrcl (A55 x6)", 0x18323000u, "a55", 0x18358800u + LMH_REG, 4, 4, "sweetrowa55", 6},  /* 1248 MHz */
-	{"perfcl (A76 x2)", 0x18325800u, "a76", 0x18350800u + LMH_REG, 1, 1, "sweetrowa76"},    /* 652 MHz */
+	{"pwrcl (A55 x6)", 0x18323000u, "a55", 0x18358800u + LMH_REG, 4, 4, "sweetrowa55", 6, "sweetgovfloor55", 6, 0, 6},  /* 1248 MHz */
+	{"perfcl (A76 x2)", 0x18325800u, "a76", 0x18350800u + LMH_REG, 1, 1, "sweetrowa76", 0, "sweetgovfloor76", 5, 6, 2}, /* 652 MHz */
 };
 
 /* 0255: what sweet_cpufreq_log() needs; each block is mapped once, in sweet_cpufreq_init */
@@ -83,6 +107,7 @@ static struct {
 	bool cap_on;            /* 0256 */
 	unsigned boot_row, cap_row, cap_floor;
 	unsigned cur_row;       /* 0257: the row last written; osm_rows_lock */
+	unsigned gov_row, gov_floor;    /* 0261: boot row with the governor off */
 } osm_state[2];
 static vm_offset_t osm_l3;
 static unsigned osm_therm_caps; /* 0256: rounds that changed a row, one "SWEET THERM: cap" line each */
@@ -94,6 +119,13 @@ static LCK_MTX_DECLARE(osm_rows_lock, &osm_rows_grp);
 
 static unsigned osm_real_mhz[2]; /* 0256: a55, a76; 0 = no reading */
 
+static unsigned osm_gov_on;      /* 0261: sweetgov */
+static unsigned osm_gov_up, osm_gov_dn;
+static unsigned osm_gov_low;     /* 0261: a domain is below its boot row, so a kick has to wake the thread */
+static uint64_t osm_gov_kick_abs, osm_gov_burst_abs;
+static int osm_gov_chan;
+static void osm_gov_start(void);
+
 SYSCTL_UINT(_kern, OID_AUTO, sweet_mhz_a55, CTLFLAG_RD | CTLFLAG_LOCKED, &osm_real_mhz[0], 0, "SWEET THERM: measured A55 MHz");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_mhz_a76, CTLFLAG_RD | CTLFLAG_LOCKED, &osm_real_mhz[1], 0, "SWEET THERM: measured A76 MHz");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_therm_caps, CTLFLAG_RD | CTLFLAG_LOCKED, &osm_therm_caps, 0, "SWEET THERM: thermal cap steps, up or down");
@@ -111,7 +143,7 @@ static void
 osm_cap_init(unsigned c, unsigned row)
 {
 	if (row < osm_state[c].n) {
-		osm_state[c].boot_row = osm_state[c].cap_row = osm_state[c].cur_row = row;
+		osm_state[c].boot_row = osm_state[c].cap_row = osm_state[c].cur_row = osm_state[c].gov_row = row;
 		osm_state[c].cap_floor = row < osm_clusters[c].cap_floor ? row : osm_clusters[c].cap_floor;
 		osm_state[c].cap_on = true;
 	}
@@ -220,6 +252,7 @@ sweet_cpufreq_init(void)
 			osm_state[c].lmh = ml_io_map(osm_clusters[c].lmh_pa, 4);
 		}
 	}
+	osm_gov_start();        /* 0261 */
 	sweet_thermal_start();
 }
 
@@ -313,6 +346,9 @@ sweet_cpufreq_log(void)
 	}
 	len += snprintf(line + len, sizeof(line) - len, " cap %u dark %u", osm_therm_caps,
 	    __atomic_load_n(&osm_dark, __ATOMIC_ACQUIRE));      /* 0257 */
+	if (osm_gov_on) {
+		len += snprintf(line + len, sizeof(line) - len, " gov up %u dn %u", osm_gov_up, osm_gov_dn);    /* 0261 */
+	}
 	printf("%s\n", line);
 }
 
@@ -342,6 +378,10 @@ osm_rows_apply(int dark)
 		if (osm_dark && row > osm_clusters[d].dark_row) {
 			row = osm_clusters[d].dark_row;
 		}
+		unsigned gov = __atomic_load_n(&osm_state[d].gov_row, __ATOMIC_ACQUIRE);        /* 0261 */
+		if (row > gov) {
+			row = gov;
+		}
 		if (row != osm_state[d].cur_row) {
 			__asm__ volatile("dmb oshst" ::: "memory");
 			*(volatile uint32_t *)(osm_state[d].base + OSM_DESIRED) = row;
@@ -361,6 +401,9 @@ void
 sweet_cpufreq_dark(int dark)
 {
 	const unsigned ndom = sizeof(osm_clusters) / sizeof(osm_clusters[0]);
+	if (!dark) {
+		sweet_cpufreq_gov_kick();       /* 0261: a wake counts as a touch, with or without sweetdarkclk */
+	}
 	if (!osm_dark_clk || !osm_rows_apply(dark ? 1 : 0)) {
 		return;
 	}
@@ -419,6 +462,150 @@ sweet_cpufreq_cap(int dir, const char *temp)
 	}
 }
 
+/*
+ * 0261: touch or display wake: boot rows for OSM_GOV_HOLD_MS. Any thread; takes no lock. Wakes the governor only while a
+ * domain is below its boot row. A kick that lands between the thread's check and its assert_wait waits for the next tick.
+ */
+void
+sweet_cpufreq_gov_kick(void)
+{
+	if (!osm_gov_on) {
+		return;
+	}
+	__atomic_store_n(&osm_gov_kick_abs, mach_absolute_time(), __ATOMIC_RELEASE);
+	if (__atomic_load_n(&osm_gov_low, __ATOMIC_ACQUIRE)) {
+		thread_wakeup((event_t)&osm_gov_chan);
+	}
+}
+
+/* 0261: every GPU submit, with sweet_gpu_lock held (which also guards the window): no blocking and no row write here */
+void
+sweet_cpufreq_gov_submit(void)
+{
+	static uint64_t win_abs;
+	static unsigned win_n;
+	if (!osm_gov_on) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now - win_abs >= osm_gov_burst_abs) {
+		win_abs = now;
+		win_n = 0;
+	}
+	if (++win_n >= OSM_GOV_BURST_N) {
+		sweet_cpufreq_gov_kick();
+	}
+}
+
+/* 0261: the only writer of gov_row; rows reach the hardware only through osm_rows_apply() */
+static void
+osm_gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	const unsigned ndom = sizeof(osm_clusters) / sizeof(osm_clusters[0]);
+	uint64_t idle_prev[8], t_prev = mach_absolute_time(), low_abs[2] = {0, 0}, hold_abs, down_abs;
+	nanoseconds_to_absolutetime((uint64_t)OSM_GOV_HOLD_MS * NSEC_PER_MSEC, &hold_abs);
+	nanoseconds_to_absolutetime((uint64_t)OSM_GOV_DOWN_MS * NSEC_PER_MSEC, &down_abs);
+	for (unsigned c = 0; c < 8; ++c) {
+		idle_prev[c] = sweet_cpu_idle_abs((int)c);
+	}
+	for (;;) {
+		uint64_t deadline;
+		unsigned tick_ms = __atomic_load_n(&sweet_display_dark, __ATOMIC_ACQUIRE) ? OSM_GOV_DARK_MS : OSM_GOV_TICK_MS;
+		clock_interval_to_deadline(tick_ms, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&osm_gov_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		uint64_t now = mach_absolute_time(), dt = now - t_prev;
+		uint64_t kick = __atomic_load_n(&osm_gov_kick_abs, __ATOMIC_ACQUIRE);
+		bool held = kick && kick + hold_abs > now;
+		unsigned busy[8];
+		for (unsigned c = 0; c < 8; ++c) {
+			uint64_t idle = sweet_cpu_idle_abs((int)c), di = idle - idle_prev[c];
+			/* as sweet_cpufreq_log(): idle 0 = no such CPU or not started yet */
+			busy[c] = (idle && dt && di <= dt) ? (unsigned)(100 - (di * 100) / dt) : 0;
+			idle_prev[c] = idle;
+		}
+		t_prev = now;
+
+		bool changed = false;
+		unsigned low = 0;
+		for (unsigned d = 0; d < ndom; ++d) {
+			if (!osm_state[d].cap_on) {
+				continue;
+			}
+			unsigned row = osm_state[d].gov_row, want = row, util = 0;
+			for (unsigned c = osm_clusters[d].cpu_first; c < osm_clusters[d].cpu_first + osm_clusters[d].cpu_n; ++c) {
+				util = busy[c] > util ? busy[c] : util;
+			}
+			if (held || util > OSM_GOV_UP_PCT) {
+				want = osm_state[d].boot_row;
+				low_abs[d] = 0;
+			} else if (util < OSM_GOV_DOWN_PCT) {
+				low_abs[d] += dt;
+				if (low_abs[d] >= down_abs) {
+					low_abs[d] = 0;
+					if (row > osm_state[d].gov_floor) {
+						want = row - 1;
+					}
+				}
+			} else {
+				low_abs[d] = 0;
+			}
+			if (want != row) {
+				__atomic_store_n(&osm_state[d].gov_row, want, __ATOMIC_RELEASE);
+				if (want > row) {
+					osm_gov_up++;
+				} else {
+					osm_gov_dn++;
+				}
+				changed = true;
+			}
+			low |= want < osm_state[d].boot_row;
+		}
+		__atomic_store_n(&osm_gov_low, low, __ATOMIC_RELEASE);
+		if (changed) {
+			(void)osm_rows_apply(-1);
+		}
+	}
+}
+
+/* 0261: sweetgov=0: no thread, and gov_row stays at the boot row, which never lowers a row in osm_rows_apply() */
+static void
+osm_gov_start(void)
+{
+	const unsigned ndom = sizeof(osm_clusters) / sizeof(osm_clusters[0]);
+	unsigned on = 0;
+	(void)PE_parse_boot_argn("sweetgov", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	char line[128];
+	unsigned len = 0;
+	len += snprintf(line + len, sizeof(line) - len, "SWEET THERM: gov on");
+	for (unsigned d = 0; d < ndom; ++d) {
+		if (!osm_state[d].cap_on) {
+			len += snprintf(line + len, sizeof(line) - len, " %s --", osm_clusters[d].tag);
+			continue;
+		}
+		unsigned floor = osm_clusters[d].gov_floor;
+		(void)PE_parse_boot_argn(osm_clusters[d].gov_arg, &floor, sizeof(floor));
+		floor = floor < osm_state[d].cap_floor ? osm_state[d].cap_floor : floor;
+		floor = floor > osm_state[d].boot_row ? osm_state[d].boot_row : floor;
+		osm_state[d].gov_floor = floor;
+		len += snprintf(line + len, sizeof(line) - len, " %s floor %u=%u boot %u=%u", osm_clusters[d].tag, floor,
+		    osm_state[d].khz[floor] / 1000, osm_state[d].boot_row, osm_state[d].khz[osm_state[d].boot_row] / 1000);
+	}
+	nanoseconds_to_absolutetime((uint64_t)OSM_GOV_BURST_MS * NSEC_PER_MSEC, &osm_gov_burst_abs);
+	thread_t t;
+	if (kernel_thread_start(osm_gov_thread, NULL, &t) != KERN_SUCCESS) {
+		printf("SWEET THERM: gov thread failed\n");
+		return;
+	}
+	thread_deallocate(t);
+	__atomic_store_n(&osm_gov_on, 1, __ATOMIC_RELEASE);
+	printf("%s\n", line);
+}
+
 /*
  * 0238 (ios-redfin 1041, MIT): kern.sweet_ui_bigcore MASK (osfmk/kern/sched_prim.c, choose_processor): 1 CA display
  * threads, 2 render-server threads on the A76 cores (CPU6/7); default 1, boot-arg sweetuibig=N, 0 off.
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 2f22476..035f35e 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -56,6 +56,7 @@ extern void sweet_smc(uint64_t x[8]);
 
 void sweet_gpu_init(void);
 extern void sweet_cpusample_tick5s(void);
+extern void sweet_cpufreq_gov_submit(void);     /* 0261: bsd/dev/sweet_cpufreq.c */
 #define GPU_TRAIL_PA	0xE2000000ull	/* sunfish: low RAM outside XNU (a6_log mirror) */
 #define GPU_TRAIL_SIZE	0x10000u
 bool sweet_gpu_ready(void);
@@ -592,6 +593,7 @@ gpu_note_submit_locked(void)
 		progress_abs = mach_absolute_time();
 	}
 	gpu_stats_locked();
+	sweet_cpufreq_gov_submit();     /* 0261: burst detection; nothing with sweetgov=0 */
 }
 
 static bool
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index bf4ab89..4bcaa6d 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -611,11 +611,13 @@ sweet_hid_key(int key, int down)
 /* 0179: last touch report, for the UI watchdog (SweetFramebuffer.cpp, sweetuiwdt) */
 extern "C" uint64_t sweet_last_touch_abs;
 uint64_t sweet_last_touch_abs;
+extern "C" void sweet_cpufreq_gov_kick(void);   /* 0261: bsd/dev/sweet_cpufreq.c */
 
 extern "C" void
 sweet_hid_touch(int finger, int down, int x, int y)
 {
 	sweet_last_touch_abs = mach_absolute_time();
+	sweet_cpufreq_gov_kick();       /* 0261: CPU rows up before the event goes out; nothing with sweetgov=0 */
 	if (gSweetTouch) {
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
-- 
