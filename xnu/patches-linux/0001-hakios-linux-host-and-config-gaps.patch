diff --git a/EXTERNAL_HEADERS/AppleKeyStore/AppleKeyStoreFSServices.h b/EXTERNAL_HEADERS/AppleKeyStore/AppleKeyStoreFSServices.h
new file mode 100644
index 0000000..2a0cb5b
--- /dev/null
+++ b/EXTERNAL_HEADERS/AppleKeyStore/AppleKeyStoreFSServices.h
@@ -0,0 +1,71 @@
+/*
+ * hakios: the SDK header bsd/sweet_hfs includes under CONFIG_PROTECT. Apple does not publish it; upstream
+ * only gets it from the macOS SDK, so a Linux build has nothing to find.
+ *
+ * The three structs are NOT invented here: they mirror, field for field, xnu's own equivalents in
+ * bsd/sys/cprotect.h (cp_cred_s, cp_wrapped_key_s, cp_raw_key_s), which exist precisely because the AKS
+ * kext and the kernel pass these shapes to each other. aks_cred_s additionally carries volume_uuid, which
+ * hfs_cprotect.c fills with uuid_copy().
+ */
+#ifndef _HAKIOS_APPLEKEYSTORE_FSSERVICES_H_
+#define _HAKIOS_APPLEKEYSTORE_FSSERVICES_H_
+
+#include <sys/cdefs.h>
+#include <sys/cprotect.h>
+#include <sys/_types/_uuid_t.h>
+
+__BEGIN_DECLS
+
+struct aks_cred_s {
+	union {
+		ino64_t			inode;
+		cp_crypto_id_t		crypto_id;
+	};
+	uint32_t			volume;
+	pid_t				pid;
+	uid_t				uid;
+	cp_key_revision_t		key_revision;
+	uuid_t				volume_uuid;
+};
+
+struct aks_wrapped_key_s {
+	void				*key;
+	unsigned			key_len;
+	cp_key_class_t			dp_class;
+};
+
+struct aks_raw_key_s {
+	void				*key;
+	unsigned			key_len;
+	void				*iv_key;
+	unsigned			iv_key_len;
+	uint32_t			flags;
+};
+
+typedef struct aks_cred_s *aks_cred_t;
+typedef struct aks_wrapped_key_s *aks_wrapped_key_t;
+typedef struct aks_raw_key_s *aks_raw_key_t;
+
+/*
+ * A flag bit of the HFS content-protection root xattr, read once in hfs_vfsutils.c to set
+ * hfsmp->cp_crypto_generation. Apple's value is not public and nothing in this tree ever writes the bit.
+ * Defining it as 0 makes the test always false, i.e. crypto generation 0, which is what the volumes this
+ * port creates are: mkiosroot builds a plain HFSX root with no content protection. A volume that really
+ * used crypto generation 1 would be misread here -- if the true value is ever learned, it goes here.
+ */
+#ifndef CP_ROOT_CRYPTOG1
+#define CP_ROOT_CRYPTOG1	0
+#endif
+
+/*
+ * A flag of aks_raw_key_s.flags: the key the keystore handed back is itself wrapped by the SEP. Same
+ * reasoning as above -- Apple's value is not public, nothing here ever sets the bit, and this kernel has
+ * no AKS provider at all (hfs_iokit.cpp's table is never registered, so hfs_unwrap_key returns ENXIO).
+ * 0 makes the test always false, which is the honest answer for a kernel that never gets a wrapped key.
+ */
+#ifndef AKS_RAW_KEY_WRAPPEDKEY
+#define AKS_RAW_KEY_WRAPPEDKEY	0
+#endif
+
+__END_DECLS
+#endif
diff --git a/EXTERNAL_HEADERS/os/firehose_buffer_private.h b/EXTERNAL_HEADERS/os/firehose_buffer_private.h
new file mode 100644
index 0000000..04a45bd
--- /dev/null
+++ b/EXTERNAL_HEADERS/os/firehose_buffer_private.h
@@ -0,0 +1,167 @@
+/*
