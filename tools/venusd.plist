<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- org.iosonpixel.venusd (video 4a, docs/features/video.md): the launchd job tools/sunfish-install-venusd.sh puts into
     the launchd.plist cache under /System/Library/LaunchDaemons/org.iosonpixel.venusd.plist, as camd's. Root, at boot,
     restarted after a crash or kill (venusd exits 1 on SIGTERM, as camd), not after a clean exit 0 (already running).
     Off: /var/local/venus-off (venusd refuses OPEN, Venus stays off). Not installed in 4a: venusd runs by hand. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.iosonpixel.venusd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/local/bin/venusd</string>
		<string>--log</string>
		<string>/var/local/venusd.log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>root</string>
	<!-- Interactive like dropbear/timed (D2): with launchd's default class venusd's 1 ms waits stretched to ~13-15 ms
	     by timer coalescing and the first frame came 7.5-9 s after OPEN (research/notes/venus-latency-2026-11-03.md). -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<!-- Credit path (VTVENUS_SURF, 331e616): each IOSurface venusd looks up maps ~3 MB into it, and up to 16 are
	     cached; with the default daemon limit jetsam killed venusd at the first credited frame (crA: "CRASH venusd
	     sig 9", reason ns 1 code 7 = per-process memory limit). crD showed launchd ignores this key for our job (as for
	     wland); venusd now sets its own limit (memorystatus_control, VENUSD_MEM_MB, default 512). Kept as documentation. -->
	<key>JetsamProperties</key>
	<dict>
		<key>JetsamMemoryLimit</key>
		<integer>128</integer>
	</dict>
</dict>
</plist>
